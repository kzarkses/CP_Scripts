// ---------------------------------------------------------------------------
// ⚠️ TOUTE VARIABLE D'UN JSFX EST GLOBALE, ET LES SECTIONS NE TOURNENT PAS SUR
// LE MEME FIL.
// ---------------------------------------------------------------------------
// @block et @sample tournent sur le FIL AUDIO. @gfx, @serialize et @slider
// tournent sur le fil de l'INTERFACE. Elles partagent toutes le meme espace de
// noms : un compteur de boucle nomme `i` dans @gfx est LE MEME que celui de
// @block, et les deux fils l'ecrivent en meme temps.
//
// Ce que ca a coute, exactement. Le drain de l'anneau de reglages fait
// `k = gmem[...]; pad(pi)[k] = valeur;` — `k` est L'INDEX DU CHAMP. @gfx s'en
// servait comme compteur de lignes de sa liste. Un reglage de volume arrive
// pendant que la fenetre dessine, et il atterrit dans P_LOADED, P_DATA,
// P_FRAMES ou P_NCH selon la ligne en cours : le pad se tait, et sa ligne passe
// a « chemin sans matiere » alors que personne n'y a touche. C'est le « plus
// aucun pad ne sonne sauf le premier », et il n'a jamais eu besoin d'un
// plantage pour arriver — juste d'une fenetre ouverte pendant qu'on regle.
//
// Le meme partage sur `i` faisait deborder la liste au-dela des 64 pads :
// l'affichage montrait des lignes 65 a 77, qui lisent la table des VOIX.
// C'est cette anomalie visible qui a fini par designer l'invisible.
//
// LA REGLE : une section qui ne tourne pas sur le fil audio prefixe ses
// variables de travail (`gx_`, `sz_`). Les fonctions, elles, declarent leurs
// locales et ne sont pas concernees.
// ---------------------------------------------------------------------------
@init
ext_noinit = 1;

NPADS    = 64;
NVOICES  = 64;
PAD_SZ   = 64;
VOICE_SZ = 32;
PAD_MEM  = 512000;      // slots par pad — voir l'en-tete
NOTE_BASE = 36;         // pad 0 <-> note 36 (convention GM/FL/Ableton)

// ---------------------------------------------------------------------------
// Carte memoire. Posee une fois ; plus rien n'alloue ensuite.
// ---------------------------------------------------------------------------
// Derniere valeur vue de chaque slider de volume. C'est ce qui permet de ne
// recopier QUE celui qui a bouge, au lieu des soixante-quatre a chaque appel.
SL_LAST     = 512;
PADS        = 1024;
VOICES      = PADS + NPADS * PAD_SZ;
OUTBUS      = VOICES + NVOICES * VOICE_SZ;
// LE CHEMIN DE CHAQUE PAD VIT DANS LE PLUGIN, en codes de caracteres. C'est
// ce qui rend le kit auto-suffisant : rouvrir un projet le fait sonner sans
// qu'aucun script tourne. Les garder cote Lua aurait fait d'une fenetre la
// condition pour entendre un projet, ce qu'aucun instrument n'accepte.
PATHS       = 8192;
PATH_LEN    = 256;
SAMPLE_BASE = PATHS + NPADS * PATH_LEN;

// Champs d'un pad -----------------------------------------------------------
P_LOADED=0;  P_DATA=1;    P_FRAMES=2;  P_NCH=3;     P_SRATE=4;
P_VOL=5;     P_PAN=6;     P_TUNE=7;    P_PLO=8;     P_PHI=9;
P_BEND=10;   P_PORTA=11;  P_ATT=12;    P_DEC=13;    P_SUS=14;
P_REL=15;    P_OBEY=16;   P_ROFF=17;   P_ROFFS=18;  P_LOOP=19;
P_LSTART=20; P_XFADE=21;  P_SOFFS=22;  P_EOFFS=23;  P_NLO=24;
P_NHI=25;    P_VLO=26;    P_VHI=27;    P_MINVOL=28; P_CHAN=29;
P_PROB=30;   P_RR=31;     P_RRST=32;   P_CHOKE=33;  P_MAXV=34;
P_OUT=35;    P_MUTE=36;   P_SOLO=37;   P_PEAK=38;   P_MODE=39;
P_INTERP=40; P_NACT=41;   P_LASTINC=42; P_ROOT=43;

// Le bloc sauvegarde va de P_VOL a P_ROOT : tout ce qui est un REGLAGE. Ce
// qui est au-dessus (pointeur, longueur, canaux) decrit la matiere en RAM et
// se reconstruit au chargement — le serialiser rendrait un pointeur mort.
P_SAVE_LO=5; P_SAVE_HI=43;

// Champs d'une voix ---------------------------------------------------------
V_ACT=0;   V_PAD=1;   V_POS=2;   V_INC=3;   V_INCT=4;   V_PORTA=5;
V_ENV=6;   V_STAGE=7; V_VEL=8;   V_NOTE=9;  V_CHAN=10;  V_AGE=11;
V_HELD=12; V_AR=13;   V_DR=14;   V_SUS=15;  V_RR=16;    V_DATA=17;
V_FRAMES=18; V_NCH=19; V_END=20; V_LP0=21;  V_LOOP=22;  V_OUT=23;
V_WAIT=24;   // echantillons a attendre avant de sonner (offset midirecv)

E_ATT=0; E_DEC=1; E_SUS=2; E_REL=3;

// gmem : seize boites, une par slot de kit. Deux kits d'un meme projet ne se
// parlent donc jamais.
//
// `gm` EST UN DECALAGE, PAS UN POINTEUR. En EEL2 il n'existe aucun moyen de
// tenir une adresse DANS gmem : gmem est un tableau a part, et on y accede
// toujours par gmem[...]. Ecrire gm[MB_SEQ] compile sans un mot et vise la
// memoire LOCALE du plugin — c'est-a-dire, ici, en plein dans la table des
// pads. Ca a coute une soiree : la boite aux lettres n'etait jamais lue, et
// elle ecrasait les pads qu'elle devait remplir. Toujours gmem[gm + X].
// LA TAILLE DE L'ANNEAU EST DIMENSIONNEE SUR LA PIRE RAFALE REELLE, pas sur
// ce qui fait joli : charger un preset ecrit soixante-quatre pads fois une
// vingtaine de reglages, soit environ mille cinq cents commandes en un seul
// appel Lua. Un anneau de trente-deux en aurait perdu les neuf dixiemes, et le
// kit serait revenu avec les reglages du precedent — silencieusement.
GM_SLOT_SZ = 12288;
GM_BASE    = 16;
// DEUX CANAUX, PARCE QU'ILS N'ONT PAS LE MEME DEBIT. Les reglages passent par
// un anneau : charger un preset de soixante-quatre pads ecrit des centaines de
// valeurs d'affilee, et attendre un accuse de reception par valeur mettrait
// plusieurs secondes a soixante hertz. Le chargement d'un echantillon, lui,
// reste une poignee de main a un seul creneau : il porte une chaine, il touche
// le disque, et il est de toute facon serialise par le disque.
MB_WPOS=0; MB_RPOS=1;                  // anneau : Lua ecrit, le JSFX lit
MB_LSEQ=2; MB_LACK=3; MB_LPAD=4;       // chargement : poignee de main
MB_STATUS=5;                           // 0 pret, 1 en cours, 2 echec, 3 tronque
MB_RING=16; RING_N=2048; RING_SZ=4;    // 16..8207  (op, pad, param, valeur)
MB_STR=8208;                           // 8208..8463 : le chemin, en codes
MB_PEAK=8464; MB_NACT=8528;            // publies vers Lua, un par pad
MB_LOADED=8592;                        // 1 = ce pad porte de la matiere
MB_HB=8720;                            // battement ecrit par Lua a chaque passage
// COMBIEN DE FOIS L'ANNEAU A DU SE RECALER. Zero est la reponse normale, et la
// seule. Autre chose veut dire que deux compteurs qui ne peuvent que monter se
// sont croises — deux instruments sur un slot, un projet ferme sous une
// ecriture — et c'est la seule trace qui restera de l'incident. Sans elle, on
// n'aurait que « le son a disparu », qui ne designe rien.
MB_RESYNC=8721;
MB_NLOADED=8656;                       // combien de pads au total
OP_NONE=0; OP_SET=1; OP_CLEAR=2; OP_CLEARALL=3;

function pad(i)      ( PADS + i * PAD_SZ );
function voice(i)    ( VOICES + i * VOICE_SZ );
function pad_mem(i)  ( SAMPLE_BASE + i * PAD_MEM );
function path_mem(i) ( PATHS + i * PATH_LEN );
function mailbox(s)  ( GM_BASE + s * GM_SLOT_SZ );

// Les defauts reprennent ceux du RS5K la ou ils existent, pour qu'un kit
// migre sans changer de son. OBEY A ZERO : un pad de batterie est un one-shot,
// une touche relachee ne doit pas le couper.
// LA PLAGE DE NOTES PAR DEFAUT EST LA NOTE DU PAD, PAS TOUT LE CLAVIER. Un
// pad neuf couvrant 0..127 ferait sonner le kit entier a chaque note — c'est
// le RS5K qui a ce defaut-la, et il n'existe que parce que chez lui un pad est
// seul sur sa piste. Ici les soixante-quatre partagent le meme flux.
function pad_defaults(p, i) (
  p[P_LOADED]=0;  p[P_DATA]=0;    p[P_FRAMES]=0;  p[P_NCH]=0;
  p[P_SRATE]=srate;
  p[P_VOL]=1;     p[P_PAN]=0;     p[P_TUNE]=0;    p[P_PLO]=0;
  p[P_PHI]=0;     p[P_BEND]=2;    p[P_PORTA]=0;   p[P_ATT]=0.001;
  p[P_DEC]=0.25;  p[P_SUS]=1;     p[P_REL]=0.001; p[P_OBEY]=0;
  p[P_ROFF]=0;    p[P_ROFFS]=0.001; p[P_LOOP]=0;  p[P_LSTART]=0;
  p[P_XFADE]=0;   p[P_SOFFS]=0;   p[P_EOFFS]=1;
  p[P_NLO]=NOTE_BASE + i;         p[P_NHI]=NOTE_BASE + i;
  p[P_VLO]=1;     p[P_VHI]=127;
  // ZERO, PAS UN. P_MINVOL est le gain a la velocite la plus basse : a 1, la
  // rampe calculee au note-on est multipliee par zero et un kit neuf n'a
  // AUCUNE dynamique — une ghost note et un accent sortent au meme niveau, et
  // rien ne dit qu'il faut toucher un bouton pour y remedier.
  p[P_MINVOL]=0;
  p[P_CHAN]=0;    p[P_PROB]=1;    p[P_RR]=0;      p[P_RRST]=0;
  p[P_CHOKE]=0;   p[P_MAXV]=4;    p[P_OUT]=0;     p[P_MUTE]=0;
  p[P_SOLO]=0;    p[P_PEAK]=0;    p[P_MODE]=0;    p[P_INTERP]=0;
  p[P_NACT]=0;    p[P_LASTINC]=0; p[P_ROOT]=NOTE_BASE + i;
);

// --- chaines ---------------------------------------------------------------
// Lua depose le chemin dans gmem en codes de caracteres, termine par zero.
// C'est la seule facon de passer une chaine a un JSFX, et elle est eprouvee
// (les outils de Saike lisent leurs chemins exactement comme ca).
// Construit une chaine EEL depuis des codes de caracteres en memoire. Le
// tampon `buf = #` est un temporaire du moteur ; on recopie ensuite dans la
// vraie destination, exactement comme le font les outils de Saike.
function readstr_from_mem(dest, cidx, maxlen) local(offset, buf) (
  offset = 0;
  buf = #;
  while (
    offset < maxlen && cidx[offset] ? (
      str_setchar(buf, offset, cidx[offset]);
      offset += 1;
      1;
    ) : 0;
  );
  strcpy_substr(dest, buf, 0, offset);
  offset;
);

// gmem -> memoire locale. Le chemin arrive de Lua en codes de caracteres ;
// on le RECOPIE dans le pad avant tout chargement, pour deux raisons : le
// creneau gmem est reutilise par le pad suivant, et le chemin doit survivre
// a la sauvegarde du projet pour que le kit se recharge tout seul.
function copy_path_from_gmem(pi) local(o, dst, src) (
  dst = path_mem(pi);
  src = gm + MB_STR;
  o = 0;
  while (o < PATH_LEN - 1 && gmem[src + o] ? ( dst[o] = gmem[src + o]; o += 1; 1; ) : 0);
  dst[o] = 0;
);

// --- chargement ------------------------------------------------------------
// Appele depuis @gfx UNIQUEMENT. file_riff rend le nombre de canaux et la
// frequence du fichier ; file_avail rend le nombre d'echantillons entrelaces
// restants. On tronque a la plage du pad plutot que de refuser : un pad qui
// sonne cinq secondes vaut mieux qu'un pad muet, et le statut le dit.
function load_pad(pi) local(p, h, nch, sr, avail, frames, cap, dest, n, i) (
  (pi < 0 || pi >= NPADS) ? ( gmem[gm + MB_STATUS] = 2; ) : (
  // ON NE REECRIT PAS LA MATIERE SOUS UNE VOIX QUI LA LIT. file_mem remplit le
  // tampon du pad pendant que @sample y lit encore : un echantillon depose sur
  // un pad qui resonne craque, ou laisse deborder un morceau de l'ancien son.
  i = 0;
  loop(NVOICES,
    (voice(i)[V_ACT] && voice(i)[V_PAD] == pi) ? voice(i)[V_ACT] = 0;
    i += 1;
  );
  p = pad(pi);
  n = readstr_from_mem(#path, path_mem(pi), PATH_LEN - 1);
  dbg_loads += 1; dbg_lastpad = pi; dbg_lastlen = n; dbg_lastres = 1;
  p[P_LOADED] = 0;
  p[P_FRAMES] = 0;
  n < 1 ? ( gmem[gm + MB_STATUS] = 0; ) : (
  h = file_open(#path);
  h >= 0 ? (
    nch = 0; sr = 0;
    file_riff(h, nch, sr);
    nch > 0 && sr > 0 ? (
      avail = file_avail(h);
      cap = floor(PAD_MEM / nch);
      frames = min(floor(avail / nch), cap);
      dest = pad_mem(pi);
      frames > 0 ? (
        file_mem(h, dest, frames * nch);
        p[P_DATA]=dest; p[P_FRAMES]=frames; p[P_NCH]=nch; p[P_SRATE]=sr;
        p[P_LOADED]=1;
        dbg_lastres = 0;
        gmem[gm + MB_STATUS] = (frames < floor(avail / nch)) ? 3 : 0;  // 3 = tronque
      ) : ( gmem[gm + MB_STATUS] = 2; );
    ) : ( gmem[gm + MB_STATUS] = 2; );
    file_close(h);
  ) : ( gmem[gm + MB_STATUS] = 2; );
  );
  );
);

// --- voix ------------------------------------------------------------------
// Vol de voix : la plus vieille du MEME pad d'abord (c'est ce que « max
// voices » veut dire), et seulement ensuite la plus vieille du kit. Un pad
// sature ne doit pas manger la reverbe d'un autre.
function find_voice(pi)
  local(i, v, free, cnt, oldest, oldage, anyold, anyage) (
  free = -1; cnt = 0; oldest = -1; oldage = 0; anyold = -1; anyage = 0;
  i = 0;
  loop(NVOICES,
    v = voice(i);
    !v[V_ACT] ? ( free < 0 ? free = i; ) : (
      v[V_PAD] == pi ? (
        cnt += 1;
        (oldest < 0 || v[V_AGE] < oldage) ? ( oldest = i; oldage = v[V_AGE]; );
      );
      (anyold < 0 || v[V_AGE] < anyage) ? ( anyold = i; anyage = v[V_AGE]; );
    );
    i += 1;
  );
  // Le pad a atteint son quota : on lui reprend SA plus vieille voix. Sinon on
  // prend une libre. En dernier ressort seulement, la plus vieille du kit —
  // et jamais la voix zero par defaut, qui volerait toujours le meme pad.
  cnt >= max(pad(pi)[P_MAXV], 1) && oldest >= 0 ? oldest :
    free >= 0 ? free :
      anyold >= 0 ? anyold : 0;
);

// Coupe les autres membres du groupe de choke. Un choke n'est pas un release :
// il doit trancher vite sans claquer, d'ou une rampe de 5 ms plutot qu'un
// arret sec ou le release du pad, qui peut durer une seconde.
function choke_group(grp, except_pad) local(i, v, p) (
  grp > 0 ? (
    i = 0;
    loop(NVOICES,
      v = voice(i);
      v[V_ACT] ? (
        p = pad(v[V_PAD]);
        (p[P_CHOKE] == grp && v[V_PAD] != except_pad) ? (
          v[V_STAGE] = E_REL;
          v[V_RR] = 1 / max(0.005 * srate, 1);
          v[V_HELD] = 0;
        );
      );
      i += 1;
    );
  );
);

function start_voice(pi, note, vel, ch, ofs)
  local(p, vi, v, semis, ratio, span, g, s0, s1, frames) (
  p = pad(pi);
  p[P_LOADED] && p[P_FRAMES] > 0 ? (
    choke_group(p[P_CHOKE], pi);
    vi = find_voice(pi);
    v = voice(vi);

    frames = p[P_FRAMES];
    s0 = floor(min(max(p[P_SOFFS], 0), 1) * frames);
    s1 = floor(min(max(p[P_EOFFS], 0), 1) * frames);
    s1 <= s0 ? s1 = frames;

    // HAUTEUR. Mode 0 : la note ne joue pas sur la hauteur (le « Sample
    // (ignores MIDI note) » du RS5K) — un kit de batterie. Mode 1 : la note
    // transpose depuis la racine, et c'est l'instrument chromatique, qui
    // devient donc un pad comme un autre au lieu d'un objet a part.
    semis = p[P_TUNE] + pitch_bend * p[P_BEND];
    p[P_MODE] >= 1 ? semis += (note - p[P_ROOT]);
    ratio = (2 ^ (semis / 12)) * (p[P_SRATE] / srate);

    v[V_PAD]=pi; v[V_POS]=s0; v[V_NOTE]=note; v[V_CHAN]=ch;
    v[V_END]=s1; v[V_DATA]=p[P_DATA]; v[V_NCH]=p[P_NCH];
    v[V_FRAMES]=frames; v[V_OUT]=min(max(p[P_OUT], 0), 7);
    v[V_LOOP]=p[P_LOOP];
    v[V_LP0]=s0 + floor(min(max(p[P_LSTART], 0), 1) * (s1 - s0));

    // PORTAMENTO. Il glisse depuis la derniere hauteur JOUEE PAR CE PAD, ce
    // qui est le seul sens qu'il ait sur un instrument polyphonique : glisser
    // depuis « la derniere note du kit » ferait chanter le charley au depart
    // de la caisse claire.
    v[V_INCT] = ratio;
    (p[P_PORTA] > 0 && p[P_LASTINC] > 0) ? (
      v[V_INC] = p[P_LASTINC];
      v[V_PORTA] = 1 / max(p[P_PORTA] * srate, 1);
    ) : ( v[V_INC] = ratio; v[V_PORTA] = 0; );
    p[P_LASTINC] = ratio;

    // VELOCITE. « Min vol » du RS5K : le gain a la velocite la plus basse.
    // Entre les deux, une droite — c'est ce que fait le RS5K, et une courbe
    // ici surprendrait un kit migre.
    span = max(p[P_VHI] - p[P_VLO], 1);
    g = min(max((vel - p[P_VLO]) / span, 0), 1);
    v[V_VEL] = p[P_MINVOL] + (1 - p[P_MINVOL]) * g;

    v[V_AR] = 1 / max(p[P_ATT] * srate, 1);
    v[V_DR] = 1 / max(p[P_DEC] * srate, 1);
    v[V_SUS] = min(max(p[P_SUS], 0), 1);
    v[V_RR] = 1 / max(p[P_REL] * srate, 1);
    v[V_ENV] = 0; v[V_STAGE] = E_ATT; v[V_HELD] = 1;
    // LE DECALAGE DANS LE BLOC EST TENU. midirecv le rend et on le jetait :
    // toutes les frappes tombaient donc sur la frontiere du bloc. A 1024
    // echantillons, deux coups distants de 10 ms arrivent ensemble et un coup
    // peut prendre 23 ms de retard — le kit sonne mou, et ca empire quand on
    // augmente le tampon, ce qui envoie chercher au mauvais endroit.
    v[V_WAIT] = max(ofs, 0);
    dbg_started += 1;
    voice_serial += 1;
    v[V_AGE] = voice_serial;
    v[V_ACT] = 1;
  );
);

function note_on(note, vel, ch, ofs) local(i, p, idx) (
  // Le pad est designe par sa note de base, et le balayage sert les pads dont
  // la PLAGE contient la note : un pad chromatique couvre le clavier, un pad
  // de batterie une seule touche, et les deux cohabitent dans le meme kit.
  i = 0;
  loop(NPADS,
    p = pad(i);
    p[P_LOADED] &&
    note >= p[P_NLO] && note <= p[P_NHI] &&
    vel  >= p[P_VLO] && vel  <= p[P_VHI] &&
    (p[P_CHAN] == 0 || p[P_CHAN] == ch + 1) &&
    !(p[P_MUTE] > 0.5) && (!any_solo || p[P_SOLO] > 0.5) ? (
      // Deux facons de ne pas jouer a chaque fois, et elles ne se melangent
      // pas. Le round-robin est DETERMINISTE — un declenchement sur N, le
      // compteur vit dans le pad et survit d'un coup a l'autre. La
      // probabilite est un tirage. Demander les deux au meme pad rendrait le
      // premier illisible, donc le round-robin gagne quand il est arme.
      p[P_RR] > 1.5 ? (
        p[P_RRST] = (p[P_RRST] + 1) % p[P_RR];
        p[P_RRST] == 0 ? start_voice(i, note, vel, ch, ofs);
      ) : (
        (p[P_PROB] >= 1 || rand(1) < p[P_PROB]) ? start_voice(i, note, vel, ch, ofs);
      );
    );
    i += 1;
  );
);

// OBEY NOTE-OFFS. A zero (le defaut d'un pad de batterie) la note-off est
// ignoree : le one-shot va au bout. A un, elle ouvre le release — et si
// « note-off release override » est arme, c'est SA duree qui s'applique, pas
// celle du release, exactement comme le RS5K.
function note_off(note, ch) local(i, v, p) (
  i = 0;
  loop(NVOICES,
    v = voice(i);
    v[V_ACT] && v[V_NOTE] == note && v[V_CHAN] == ch && v[V_HELD] ? (
      p = pad(v[V_PAD]);
      v[V_HELD] = 0;
      // UNE BOUCLE REPOND TOUJOURS AU RELACHEMENT. Un one-shot qui ignore la
      // note-off va au bout de sa matiere et meurt tout seul ; une BOUCLE n'a
      // pas de bout. Avec obey a zero — le defaut d'un pad — elle devenait une
      // voix immortelle qu'il fallait tuer en frappant le pad cinq fois.
      (p[P_OBEY] > 0.5 || p[P_LOOP] > 0.5) ? (
        v[V_STAGE] = E_REL;
        p[P_ROFF] > 0.5 ? v[V_RR] = 1 / max(p[P_ROFFS] * srate, 1);
      );
    );
    i += 1;
  );
);

function all_off() local(i) (
  i = 0;
  loop(NVOICES,
    voice(i)[V_ACT] ? (
      voice(i)[V_STAGE] = E_REL;
      voice(i)[V_RR] = 1 / max(0.005 * srate, 1);
      voice(i)[V_HELD] = 0;
    );
    i += 1;
  );
);

// --- rendu -----------------------------------------------------------------
// Le corps chaud. Rien ici ne divise, rien n'appelle file_*, rien n'alloue.
function render_voice(v)
  local(p, d, nch, ip, fr, a, b, l, r, e, st, o, gl, gr, g, pan) (
  p = pad(v[V_PAD]);

  // Enveloppe. Une addition et une comparaison par echantillon.
  st = v[V_STAGE];
  st == E_ATT ? (
    v[V_ENV] += v[V_AR];
    v[V_ENV] >= 1 ? ( v[V_ENV] = 1; v[V_STAGE] = E_DEC; );
  ) : st == E_DEC ? (
    v[V_ENV] -= v[V_DR] * (1 - v[V_SUS]);
    v[V_ENV] <= v[V_SUS] ? ( v[V_ENV] = v[V_SUS]; v[V_STAGE] = E_SUS; );
  ) : st == E_REL ? (
    v[V_ENV] -= v[V_RR];
    v[V_ENV] <= 0 ? ( v[V_ENV] = 0; v[V_ACT] = 0; );
  );

  // L'attente du decalage : la voix existe, elle ne sonne pas encore.
  v[V_WAIT] > 0 ? ( v[V_WAIT] -= 1; ) :
  v[V_ACT] ? (
    // Portamento : l'increment glisse vers sa cible, il ne saute pas.
    v[V_PORTA] > 0 ? (
      v[V_INC] < v[V_INCT] ? (
        v[V_INC] += (v[V_INCT] - v[V_INC]) * v[V_PORTA] * 8;
        v[V_INC] >= v[V_INCT] ? ( v[V_INC]=v[V_INCT]; v[V_PORTA]=0; );
      ) : (
        v[V_INC] -= (v[V_INC] - v[V_INCT]) * v[V_PORTA] * 8;
        v[V_INC] <= v[V_INCT] ? ( v[V_INC]=v[V_INCT]; v[V_PORTA]=0; );
      );
    );

    d = v[V_DATA]; nch = v[V_NCH];
    ip = floor(v[V_POS]);
    fr = v[V_POS] - ip;

    ip >= 0 && ip < v[V_END] - 1 ? (
      // LE PAS EST LE NOMBRE DE CANAUX DU FICHIER, pas deux. Un wav a quatre
      // ou six canaux (multi-micro, ambisonique) lu avec un pas de deux sort
      // deux a trois fois trop lent, avec les micros qui passent les uns dans
      // les autres — et c'est le fichier qu'on accuse.
      nch >= 2 ? (
        a = d[ip * nch]; b = d[ip * nch + nch];
        l = a + (b - a) * fr;
        a = d[ip * nch + 1]; b = d[ip * nch + nch + 1];
        r = a + (b - a) * fr;
      ) : (
        a = d[ip]; b = d[ip + 1];
        l = a + (b - a) * fr;
        r = l;
      );
    ) : ( l = 0; r = 0; );

    v[V_POS] += v[V_INC];
    v[V_POS] >= v[V_END] - 1 ? (
      v[V_LOOP] > 0.5 ? v[V_POS] = v[V_LP0] : ( v[V_ACT] = 0; );
    );

    e = v[V_ENV] * v[V_VEL] * p[P_VOL];
    // Panoramique a puissance constante approchee : deux multiplications, pas
    // de sinus. Sur un PC de 2005 la difference s'entend au compteur, pas a
    // l'oreille.
    pan = min(max(p[P_PAN], -1), 1);
    gl = e * (1 - max(pan, 0));
    gr = e * (1 + min(pan, 0));

    o = v[V_OUT] * 2;
    OUTBUS[o]     += l * gl;
    OUTBUS[o + 1] += r * gr;

    g = abs(l * gl) + abs(r * gr);
    g > p[P_PEAK] ? p[P_PEAK] = g;
  );
);

// --- etat initial ----------------------------------------------------------
i = 0;
loop(NPADS, pad_defaults(pad(i), i); i += 1;);
i = 0;
loop(NVOICES, voice(i)[V_ACT] = 0; i += 1;);

ser_version  = 1;
// COMPTEURS DE DIAGNOSTIC. Ils ne servent qu'a la fenetre, ils ne coutent
// qu'une addition, et ils repondent a la seule question qui compte quand rien
// ne sort : est-ce que la matiere est arrivee, et est-ce que la note est
// arrivee. Sans eux, « pas de son » n'a aucune moitie identifiable.
dbg_notes    = 0;   // notes recues depuis le chargement du plugin
dbg_started  = 0;   // notes qui ont REELLEMENT ouvert une voix
dbg_lastnote = -1;
dbg_lastvel  = 0;
dbg_loads    = 0;   // tentatives de chargement
dbg_lastres  = -1;  // -1 aucune, 0 ok, 2 echec, 3 tronque
dbg_lastpad  = -1;
dbg_lastlen  = 0;   // longueur du dernier chemin lu
dbg_gfx      = 0;   // @gfx a-t-il tourne, et combien de fois
dbg_sets     = 0;   // reglages recus
dbg_spad     = -1;  // ...du dernier : quel pad
dbg_sfield   = -1;  // ...quel champ
dbg_sval     = 0;   // ...quelle valeur
voice_serial = 0;
any_solo     = 0;
pitch_bend   = 0;
pending_load = -1;
reload_next  = -1;
load_wait    = 0;
reload_wait  = 0;
master_gain  = 1;
gm           = mailbox(0);

// RESERVES, ET ON LE DIT PLUTOT QUE DE LAISSER CROIRE. Ces quatre champs
// existent dans la table et se serialisent deja — rien ne les lit encore :
//   P_XFADE   fondu de boucle (le « Xfade » du RS5K)
//   P_INTERP  qualite de reechantillonnage (on est en lineaire)
//   P_PLO/PHI pitch@start / pitch@end — le mode chromatique passe pour
//             l'instant par P_ROOT, qui dit la meme chose plus simplement
// Sept champs morts voyageaient deja dans chaque .RPP de la Session et c'est
// au registre des defauts sous « ce qui trompe » : un format qui promet un
// modele que rien n'implemente se paie plus tard.

@serialize
// L'ETAT DU KIT EST DANS LE PROJET, PAS DANS UN FICHIER A COTE. Un .RPP
// emporte son kit — reglages ET chemins ; seule la matiere reste dehors,
// comme n'importe quel media de REAPER.
//
// ON NE SERIALISE PAS LA MATIERE : un pointeur sauvegarde serait un pointeur
// mort au rechargement, et un .RPP de trois cents megaoctets serait un bug
// deguise en fonctionnalite. On resauve les CHEMINS, et on recharge.
//
// file_avail rend une valeur negative en ecriture : c'est ainsi qu'un JSFX
// sait dans quel sens il travaille.
file_var(0, ser_version);
sz_i = 0;
loop(NPADS,
  sz_p = pad(sz_i);
  sz_j = P_SAVE_LO;
  loop(P_SAVE_HI - P_SAVE_LO + 1, file_var(0, sz_p[sz_j]); sz_j += 1;);
  sz_i += 1;
);
file_mem(0, PATHS, NPADS * PATH_LEN);

// A LA LECTURE SEULEMENT : on redemande le chargement de tous les pads qui
// ont un chemin. @gfx en prend UN par passage — soixante-quatre lectures de
// disque d'affilee figeraient REAPER a l'ouverture du projet, et un kit qui
// se remplit en une seconde ne derange personne.
file_avail(0) >= 0 ? ( reload_next = 0; );

@slider
gm = mailbox(min(max(slider1, 0), 15));
master_gain = 10 ^ (slider2 / 20);

// LE VOLUME D'UN PAD A DEUX ECRIVAINS, ET UN SEUL DOIT GAGNER A LA FOIS.
// Lua l'ecrit par l'anneau ; @slider le recalculait pour les SOIXANTE-QUATRE
// pads a chaque appel, c'est-a-dire au moindre changement de n'importe quel
// slider — y compris celui du slot, pose a la creation du kit. On equilibrait
// un kit, on deposait l'echantillon suivant, et tout revenait a 0 dB pendant
// que les boutons affichaient toujours l'equilibre. Un seul reglage sur
// quarante mentait, ce qui le rendait illisible.
//
// On ne recopie donc QUE le slider qui a bouge. Il reste un parametre
// automatisable et reprend la main des qu'on le touche ; le reste du temps
// c'est Lua qui parle.
slider9 != SL_LAST[0] ? ( SL_LAST[0] = slider9; pad(0)[P_VOL] = 10 ^ (slider9 / 20); );
slider10 != SL_LAST[1] ? ( SL_LAST[1] = slider10; pad(1)[P_VOL] = 10 ^ (slider10 / 20); );
slider11 != SL_LAST[2] ? ( SL_LAST[2] = slider11; pad(2)[P_VOL] = 10 ^ (slider11 / 20); );
slider12 != SL_LAST[3] ? ( SL_LAST[3] = slider12; pad(3)[P_VOL] = 10 ^ (slider12 / 20); );
slider13 != SL_LAST[4] ? ( SL_LAST[4] = slider13; pad(4)[P_VOL] = 10 ^ (slider13 / 20); );
slider14 != SL_LAST[5] ? ( SL_LAST[5] = slider14; pad(5)[P_VOL] = 10 ^ (slider14 / 20); );
slider15 != SL_LAST[6] ? ( SL_LAST[6] = slider15; pad(6)[P_VOL] = 10 ^ (slider15 / 20); );
slider16 != SL_LAST[7] ? ( SL_LAST[7] = slider16; pad(7)[P_VOL] = 10 ^ (slider16 / 20); );
slider17 != SL_LAST[8] ? ( SL_LAST[8] = slider17; pad(8)[P_VOL] = 10 ^ (slider17 / 20); );
slider18 != SL_LAST[9] ? ( SL_LAST[9] = slider18; pad(9)[P_VOL] = 10 ^ (slider18 / 20); );
slider19 != SL_LAST[10] ? ( SL_LAST[10] = slider19; pad(10)[P_VOL] = 10 ^ (slider19 / 20); );
slider20 != SL_LAST[11] ? ( SL_LAST[11] = slider20; pad(11)[P_VOL] = 10 ^ (slider20 / 20); );
slider21 != SL_LAST[12] ? ( SL_LAST[12] = slider21; pad(12)[P_VOL] = 10 ^ (slider21 / 20); );
slider22 != SL_LAST[13] ? ( SL_LAST[13] = slider22; pad(13)[P_VOL] = 10 ^ (slider22 / 20); );
slider23 != SL_LAST[14] ? ( SL_LAST[14] = slider23; pad(14)[P_VOL] = 10 ^ (slider23 / 20); );
slider24 != SL_LAST[15] ? ( SL_LAST[15] = slider24; pad(15)[P_VOL] = 10 ^ (slider24 / 20); );
slider25 != SL_LAST[16] ? ( SL_LAST[16] = slider25; pad(16)[P_VOL] = 10 ^ (slider25 / 20); );
slider26 != SL_LAST[17] ? ( SL_LAST[17] = slider26; pad(17)[P_VOL] = 10 ^ (slider26 / 20); );
slider27 != SL_LAST[18] ? ( SL_LAST[18] = slider27; pad(18)[P_VOL] = 10 ^ (slider27 / 20); );
slider28 != SL_LAST[19] ? ( SL_LAST[19] = slider28; pad(19)[P_VOL] = 10 ^ (slider28 / 20); );
slider29 != SL_LAST[20] ? ( SL_LAST[20] = slider29; pad(20)[P_VOL] = 10 ^ (slider29 / 20); );
slider30 != SL_LAST[21] ? ( SL_LAST[21] = slider30; pad(21)[P_VOL] = 10 ^ (slider30 / 20); );
slider31 != SL_LAST[22] ? ( SL_LAST[22] = slider31; pad(22)[P_VOL] = 10 ^ (slider31 / 20); );
slider32 != SL_LAST[23] ? ( SL_LAST[23] = slider32; pad(23)[P_VOL] = 10 ^ (slider32 / 20); );
slider33 != SL_LAST[24] ? ( SL_LAST[24] = slider33; pad(24)[P_VOL] = 10 ^ (slider33 / 20); );
slider34 != SL_LAST[25] ? ( SL_LAST[25] = slider34; pad(25)[P_VOL] = 10 ^ (slider34 / 20); );
slider35 != SL_LAST[26] ? ( SL_LAST[26] = slider35; pad(26)[P_VOL] = 10 ^ (slider35 / 20); );
slider36 != SL_LAST[27] ? ( SL_LAST[27] = slider36; pad(27)[P_VOL] = 10 ^ (slider36 / 20); );
slider37 != SL_LAST[28] ? ( SL_LAST[28] = slider37; pad(28)[P_VOL] = 10 ^ (slider37 / 20); );
slider38 != SL_LAST[29] ? ( SL_LAST[29] = slider38; pad(29)[P_VOL] = 10 ^ (slider38 / 20); );
slider39 != SL_LAST[30] ? ( SL_LAST[30] = slider39; pad(30)[P_VOL] = 10 ^ (slider39 / 20); );
slider40 != SL_LAST[31] ? ( SL_LAST[31] = slider40; pad(31)[P_VOL] = 10 ^ (slider40 / 20); );
slider41 != SL_LAST[32] ? ( SL_LAST[32] = slider41; pad(32)[P_VOL] = 10 ^ (slider41 / 20); );
slider42 != SL_LAST[33] ? ( SL_LAST[33] = slider42; pad(33)[P_VOL] = 10 ^ (slider42 / 20); );
slider43 != SL_LAST[34] ? ( SL_LAST[34] = slider43; pad(34)[P_VOL] = 10 ^ (slider43 / 20); );
slider44 != SL_LAST[35] ? ( SL_LAST[35] = slider44; pad(35)[P_VOL] = 10 ^ (slider44 / 20); );
slider45 != SL_LAST[36] ? ( SL_LAST[36] = slider45; pad(36)[P_VOL] = 10 ^ (slider45 / 20); );
slider46 != SL_LAST[37] ? ( SL_LAST[37] = slider46; pad(37)[P_VOL] = 10 ^ (slider46 / 20); );
slider47 != SL_LAST[38] ? ( SL_LAST[38] = slider47; pad(38)[P_VOL] = 10 ^ (slider47 / 20); );
slider48 != SL_LAST[39] ? ( SL_LAST[39] = slider48; pad(39)[P_VOL] = 10 ^ (slider48 / 20); );
slider49 != SL_LAST[40] ? ( SL_LAST[40] = slider49; pad(40)[P_VOL] = 10 ^ (slider49 / 20); );
slider50 != SL_LAST[41] ? ( SL_LAST[41] = slider50; pad(41)[P_VOL] = 10 ^ (slider50 / 20); );
slider51 != SL_LAST[42] ? ( SL_LAST[42] = slider51; pad(42)[P_VOL] = 10 ^ (slider51 / 20); );
slider52 != SL_LAST[43] ? ( SL_LAST[43] = slider52; pad(43)[P_VOL] = 10 ^ (slider52 / 20); );
slider53 != SL_LAST[44] ? ( SL_LAST[44] = slider53; pad(44)[P_VOL] = 10 ^ (slider53 / 20); );
slider54 != SL_LAST[45] ? ( SL_LAST[45] = slider54; pad(45)[P_VOL] = 10 ^ (slider54 / 20); );
slider55 != SL_LAST[46] ? ( SL_LAST[46] = slider55; pad(46)[P_VOL] = 10 ^ (slider55 / 20); );
slider56 != SL_LAST[47] ? ( SL_LAST[47] = slider56; pad(47)[P_VOL] = 10 ^ (slider56 / 20); );
slider57 != SL_LAST[48] ? ( SL_LAST[48] = slider57; pad(48)[P_VOL] = 10 ^ (slider57 / 20); );
slider58 != SL_LAST[49] ? ( SL_LAST[49] = slider58; pad(49)[P_VOL] = 10 ^ (slider58 / 20); );
slider59 != SL_LAST[50] ? ( SL_LAST[50] = slider59; pad(50)[P_VOL] = 10 ^ (slider59 / 20); );
slider60 != SL_LAST[51] ? ( SL_LAST[51] = slider60; pad(51)[P_VOL] = 10 ^ (slider60 / 20); );
slider61 != SL_LAST[52] ? ( SL_LAST[52] = slider61; pad(52)[P_VOL] = 10 ^ (slider61 / 20); );
slider62 != SL_LAST[53] ? ( SL_LAST[53] = slider62; pad(53)[P_VOL] = 10 ^ (slider62 / 20); );
slider63 != SL_LAST[54] ? ( SL_LAST[54] = slider63; pad(54)[P_VOL] = 10 ^ (slider63 / 20); );
slider64 != SL_LAST[55] ? ( SL_LAST[55] = slider64; pad(55)[P_VOL] = 10 ^ (slider64 / 20); );
slider65 != SL_LAST[56] ? ( SL_LAST[56] = slider65; pad(56)[P_VOL] = 10 ^ (slider65 / 20); );
slider66 != SL_LAST[57] ? ( SL_LAST[57] = slider66; pad(57)[P_VOL] = 10 ^ (slider66 / 20); );
slider67 != SL_LAST[58] ? ( SL_LAST[58] = slider67; pad(58)[P_VOL] = 10 ^ (slider67 / 20); );
slider68 != SL_LAST[59] ? ( SL_LAST[59] = slider68; pad(59)[P_VOL] = 10 ^ (slider68 / 20); );
slider69 != SL_LAST[60] ? ( SL_LAST[60] = slider69; pad(60)[P_VOL] = 10 ^ (slider69 / 20); );
slider70 != SL_LAST[61] ? ( SL_LAST[61] = slider70; pad(61)[P_VOL] = 10 ^ (slider70 / 20); );
slider71 != SL_LAST[62] ? ( SL_LAST[62] = slider71; pad(62)[P_VOL] = 10 ^ (slider71 / 20); );
slider72 != SL_LAST[63] ? ( SL_LAST[63] = slider72; pad(63)[P_VOL] = 10 ^ (slider72 / 20); );

@block
// 1. L'anneau des reglages. On draine TOUT ce qui est arrive depuis le bloc
//    precedent : c'est de l'ecriture en memoire, ca ne coute rien, et ca evite
//    qu'un preset de soixante-quatre pads s'etale sur plusieurs secondes.
//    L'anneau peut deborder si Lua ecrit plus de trente-deux commandes entre
//    deux blocs — il ne le fait pas, et s'il le faisait la perte serait un
//    reglage en retard d'un bloc, pas un son faux.
// ⚠️ CETTE BOUCLE EST BORNEE, ET CE N'EST PAS DE LA PRUDENCE.
//
// `rpos` et `wpos` vivent dans gmem, qui est GLOBAL A REAPER : il survit a la
// fermeture d'un projet, a la reinstanciation du plugin, au redemarrage des
// scripts, et personne ne le remet a zero — c'est voulu, les deux cotes sont
// sans etat et se relisent l'un l'autre.
//
// Mais la condition d'arret est « les deux compteurs sont DIFFERENTS », et il
// suffit que `rpos` DEPASSE `wpos` une seule fois pour qu'elle reste vraie
// pendant des milliers de milliards de tours. Deux instruments sur le meme slot
// de kit — donc deux draineurs sur le meme anneau, chacun avancant rpos —
// suffisent. Un projet ferme pendant qu'une ecriture etait en vol aussi.
//
// Ce n'est pas une lenteur : le bloc ne rend JAMAIS la main. L'appareil
// decroche, et de l'exterieur ca ne se lit pas comme un anneau desynchronise,
// ca se lit « le moteur audio a plante ». C'est exactement la meme faute que
// celle qu'on venait de fermer dans le repli d'une voix, et pour la meme raison :
// une DONNEE decidait du nombre de tours.
//
// On draine donc au plus RING_N entrees, et si l'ecart n'a plus de sens on se
// RECALE sur wpos au lieu de tourner. On y perd des reglages — ce que l'anneau
// perd deja quand il fait le tour, et que Lua compte — et on ne perd jamais le
// fil audio. Perdre un reglage se voit et se refait ; perdre le fil audio arrete
// la musique.
rq_d = gmem[gm + MB_WPOS] - gmem[gm + MB_RPOS];
(rq_d < 0 || rq_d > RING_N) ? (
  gmem[gm + MB_RPOS] = gmem[gm + MB_WPOS];
  gmem[gm + MB_RESYNC] = gmem[gm + MB_RESYNC] + 1;
);
rq_n = 0;
while (gmem[gm + MB_RPOS] != gmem[gm + MB_WPOS] && rq_n < RING_N) (
  rq_n += 1;
  e = MB_RING + (gmem[gm + MB_RPOS] % RING_N) * RING_SZ;
  op = gmem[gm + e];
  pi = gmem[gm + e + 1];
  op == OP_SET && pi >= 0 && pi < NPADS ? (
    k = gmem[gm + e + 2];
    k >= 0 && k < PAD_SZ ? (
      pad(pi)[k] = gmem[gm + e + 3];
      dbg_sets += 1; dbg_spad = pi; dbg_sfield = k;
      dbg_sval = gmem[gm + e + 3];
    );
  ) : op == OP_CLEAR && pi >= 0 && pi < NPADS ? (
    // LE CHEMIN PART AUSSI, ET LES REGLAGES REVIENNENT AU NEUF. Sans le
    // chemin, @serialize le resauve et le pad RESSUSCITE a la reouverture du
    // projet : vide a l'ecran, sonore sous les doigts. Sans les reglages, un
    // solo oublie sur un pad supprime rend tout le kit muet sans que rien ne
    // le dise, et un pad recycle nait mute.
    path_mem(pi)[0] = 0;
    pad_defaults(pad(pi), pi);
  ) : op == OP_CLEARALL ? (
    i = 0;
    loop(NPADS, path_mem(i)[0] = 0; pad_defaults(pad(i), i); i += 1;);
  );
  gmem[gm + MB_RPOS] = gmem[gm + MB_RPOS] + 1;
);

// 2. Le chargement, qui est une poignee de main a un seul creneau : il porte
//    une chaine et il touche le disque. On ne fait que poser le drapeau — le
//    disque appartient a @gfx. L'ACCUSE DE RECEPTION N'EST DONNE QU'UNE FOIS
//    LE FICHIER LU : Lua saura que le pad SONNE, pas que l'ordre est parti.
//    Un garde-fou qui verifie le geste et non son resultat ne garde rien.
// LE CHARGEMENT SE FAIT ICI, TOUT DE SUITE, ET C'EST UN AVEU.
//
// Il vivait dans @gfx, et le raisonnement etait bon : @gfx n'est pas le fil
// audio, donc lire trente megaoctets n'y coute aucun craquement, et gfx_idle
// est cense l'y faire tourner fenetre fermee. Il ne le fait pas de facon
// fiable. Le symptome, mesure : la demande arrive (le statut passe a « en
// cours », donc gmem vit et @block tourne), et elle ne se termine JAMAIS.
//
// Un repli temporise a d'abord ete tente — attendre deux cents blocs puis
// charger ici. Il ne suffit pas : deux cents blocs, c'est deux secondes de
// traitement AUDIO, et une piste au repos n'en produit pas. On attendait donc
// un evenement qui ne venait pas, pour eviter un craquement que personne
// n'aurait entendu.
//
// Donc : le disque passe par le fil audio, au moment ou l'utilisateur depose
// un echantillon. Ca coute un clic, une fois, sur un geste ou il s'y attend —
// c'est exactement ce que fait un RS5K, et tous les echantillonneurs. La
// regle des zero allocations vaut pour ce qui tourne PAR ECHANTILLON et PAR
// FRAME ; elle n'a jamais voulu dire qu'un chargement doit ne jamais avoir
// lieu. Un instrument muet est un moins bon instrument qu'un instrument qui
// clique une fois.
gmem[gm + MB_LSEQ] != gmem[gm + MB_LACK] ? (
  pending_load = gmem[gm + MB_LPAD];
  copy_path_from_gmem(pending_load);
  load_pad(pending_load);
  pending_load = -1;
  gmem[gm + MB_LACK] = gmem[gm + MB_LSEQ];
) : reload_next >= 0 ? (
  // OUVERTURE DE PROJET : un pad par bloc, pour ne pas figer REAPER sur une
  // seule passe. Soixante-quatre pads arrivent en moins d'une seconde.
  path_mem(reload_next)[0] ? load_pad(reload_next);
  reload_next += 1;
  reload_next >= NPADS ? reload_next = -1;
);

// Le solo vaut pour tout le kit : une fois par bloc, pas par pad et par
// echantillon.
any_solo = 0;
i = 0;
loop(NPADS, pad(i)[P_SOLO] > 0.5 ? any_solo = 1; i += 1;);

// 2. Le MIDI.
while (midirecv(mofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  ch = m1 & 0x0F;
  st == 0x90 && m3 > 0 ? (
    dbg_notes += 1; dbg_lastnote = m2; dbg_lastvel = m3;
    note_on(m2, m3, ch, mofs);
  )
  : (st == 0x80 || (st == 0x90 && m3 == 0)) ? note_off(m2, ch)
  : st == 0xE0 ? ( pitch_bend = (((m3 << 7) | m2) - 8192) / 8192; )
  : (st == 0xB0 && (m2 == 123 || m2 == 120)) ? all_off();
  // ON NE REPASSE PAS LA NOTE. L'instrument l'a consommee ; la renvoyer la
  // ferait jouer deux fois par le prochain effet de la chaine. Le « remove
  // played notes from FX chain » du RS5K disparait donc comme reglage : il
  // est devenu le comportement.
);

// 3. Les cretes et le compte de voix, pour les VU de la fenetre. Une fois par
//    bloc : un VU n'a pas besoin de mieux que soixante hertz.
nloaded = 0;
i = 0;
loop(NPADS,
  gmem[gm + MB_PEAK + i] = pad(i)[P_PEAK];
  pad(i)[P_PEAK] *= 0.55;
  pad(i)[P_NACT] = 0;
  i += 1;
);
i = 0;
loop(NVOICES,
  voice(i)[V_ACT] ? pad(voice(i)[V_PAD])[P_NACT] += 1;
  i += 1;
);
i = 0;
loop(NPADS,
  gmem[gm + MB_NACT + i]   = pad(i)[P_NACT];
  // CE QUE LUA VERIFIE. « Le pad porte-t-il de la matiere », pas « l'ordre
  // est-il parti » : une migration qui controle le geste et non son resultat
  // ne garde rien, et celle du 1er aout a supprime des pistes dont les
  // echantillons n'avaient pas suivi.
  gmem[gm + MB_LOADED + i] = pad(i)[P_LOADED] && pad(i)[P_FRAMES] > 0;
  nloaded += gmem[gm + MB_LOADED + i];
  i += 1;
);
gmem[gm + MB_NLOADED] = nloaded;

@sample
o = 0;
loop(16, OUTBUS[o] = 0; o += 1;);

vi = 0;
loop(NVOICES,
  voice(vi)[V_ACT] ? render_voice(voice(vi));
  vi += 1;
);

spl0 += OUTBUS[0] * master_gain;  spl1 += OUTBUS[1] * master_gain;
spl2 += OUTBUS[2] * master_gain;  spl3 += OUTBUS[3] * master_gain;
spl4 += OUTBUS[4] * master_gain;  spl5 += OUTBUS[5] * master_gain;
spl6 += OUTBUS[6] * master_gain;  spl7 += OUTBUS[7] * master_gain;
spl8 += OUTBUS[8] * master_gain;  spl9 += OUTBUS[9] * master_gain;
spl10 += OUTBUS[10] * master_gain;  spl11 += OUTBUS[11] * master_gain;
spl12 += OUTBUS[12] * master_gain;  spl13 += OUTBUS[13] * master_gain;
spl14 += OUTBUS[14] * master_gain;  spl15 += OUTBUS[15] * master_gain;

@gfx 560 420
// LE DISQUE EST ICI. gfx_idle=1 fait tourner cette section fenetre fermee : un
// kit se charge sans qu'on ouvre quoi que ce soit, et un fichier de trente
// megaoctets ne fait pas craquer le fil audio.
//
// ET LA FENETRE DIT CE QUI SE PASSE. « Aucun son » a exactement deux moities :
// la matiere n'est pas arrivee, ou la note n'est pas arrivee. Un instrument
// qui ne sait pas dire laquelle oblige a deviner, et deviner a deja coute
// trois soirees ici. Tout ce qui suit ne fait que LIRE des compteurs.
dbg_gfx += 1;

// --- ce que la fenetre raconte ---------------------------------------------
gfx_set(0.09, 0.09, 0.10, 1); gfx_rect(0, 0, gfx_w, gfx_h);
gfx_setfont(1, "Arial", 15);
gfx_set(0.85, 0.86, 0.88, 1);
gfx_x = 12; gfx_y = 10; gfx_drawstr("CP Kit Sampler");

gfx_setfont(2, "Arial", 13);
gfx_set(0.60, 0.62, 0.66, 1);
gfx_x = 12; gfx_y = 32;
gfx_drawstr("slot "); gfx_drawnumber(slider1, 0);
gfx_drawstr("   pads charges "); gfx_drawnumber(nloaded, 0);
gfx_drawstr(" / 64");

gfx_x = 12; gfx_y = 52;
gfx_drawstr("chargements tentes "); gfx_drawnumber(dbg_loads, 0);
gfx_drawstr("   dernier pad "); gfx_drawnumber(dbg_lastpad, 0);
gfx_drawstr("   chemin lu "); gfx_drawnumber(dbg_lastlen, 0);
gfx_drawstr(" car.");

gfx_x = 12; gfx_y = 72;
gfx_drawstr("resultat : ");
dbg_lastres == 0 ? ( gfx_set(0.45, 0.85, 0.50, 1); gfx_drawstr("charge"); )
: dbg_lastres == 2 ? ( gfx_set(0.95, 0.45, 0.40, 1); gfx_drawstr("ECHEC (file_open ou file_riff)"); )
: dbg_lastres == 3 ? ( gfx_set(0.95, 0.80, 0.40, 1); gfx_drawstr("tronque"); )
: dbg_lastres == 1 ? ( gfx_set(0.95, 0.80, 0.40, 1); gfx_drawstr("en cours"); )
: ( gfx_set(0.55, 0.55, 0.58, 1); gfx_drawstr("aucune tentative"); );

gfx_set(0.60, 0.62, 0.66, 1);
gfx_x = 12; gfx_y = 96;
gfx_drawstr("notes recues "); gfx_drawnumber(dbg_notes, 0);
gfx_drawstr("   dont jouees "); gfx_drawnumber(dbg_started, 0);
gfx_drawstr("   derniere "); gfx_drawnumber(dbg_lastnote, 0);
gfx_drawstr(" vel "); gfx_drawnumber(dbg_lastvel, 0);

gfx_x = 12; gfx_y = 116;
dbg_notes == 0 ? (
  gfx_set(0.95, 0.45, 0.40, 1);
  gfx_drawstr("AUCUNE NOTE N'ARRIVE — le probleme est le MIDI, pas l'instrument");
) : dbg_started == 0 ? (
  gfx_set(0.95, 0.45, 0.40, 1);
  gfx_drawstr("des notes arrivent mais aucun pad ne repond — plage de notes, ou rien de charge");
) : nloaded == 0 ? (
  gfx_set(0.95, 0.45, 0.40, 1);
  gfx_drawstr("aucune matiere chargee — voir le resultat ci-dessus");
) : (
  gfx_set(0.45, 0.85, 0.50, 1);
  gfx_drawstr("l'instrument recoit et joue");
);

// LES MOTS BRUTS DE LA BOITE AUX LETTRES. C'est la mesure qui tranche entre
// « Lua n'ecrit pas » et « le JSFX ne lit pas au bon endroit » : le battement
// avance a chaque passage de la fenetre, et les compteurs de sequence disent
// si une demande est en attente. Tout a zero veut dire que les deux ne
// partagent pas la meme gmem, et rien d'autre.
gfx_set(0.55, 0.70, 0.90, 1);
gfx_x = 12; gfx_y = 140;
gfx_drawstr("gmem base "); gfx_drawnumber(gm, 0);
gfx_drawstr("   battement Lua "); gfx_drawnumber(gmem[gm + MB_HB], 0);
gfx_x = 12; gfx_y = 158;
gfx_drawstr("lseq "); gfx_drawnumber(gmem[gm + MB_LSEQ], 0);
gfx_drawstr("  lack "); gfx_drawnumber(gmem[gm + MB_LACK], 0);
gfx_drawstr("  lpad "); gfx_drawnumber(gmem[gm + MB_LPAD], 0);
gfx_drawstr("  wpos "); gfx_drawnumber(gmem[gm + MB_WPOS], 0);
gfx_drawstr("  rpos "); gfx_drawnumber(gmem[gm + MB_RPOS], 0);
gfx_x = 12; gfx_y = 176;
gmem[gm + MB_HB] == 0 ? (
  gfx_set(0.95, 0.45, 0.40, 1);
  gfx_drawstr("gmem MUET — la fenetre et l'instrument ne partagent pas la meme memoire");
) : (
  gfx_set(0.45, 0.85, 0.50, 1);
  gfx_drawstr("gmem vivant");
);

// LE DERNIER REGLAGE RECU. « Le bouton ne fait rien » a deux moitiés comme
// le reste : ou il n'arrive pas, ou il arrive et ne s'entend pas. Ces quatre
// nombres disent laquelle.
gfx_set(0.70, 0.66, 0.90, 1);
gfx_x = 12; gfx_y = 196;
gfx_drawstr("reglages recus "); gfx_drawnumber(dbg_sets, 0);
gfx_drawstr("   dernier : pad "); gfx_drawnumber(dbg_spad, 0);
gfx_drawstr("  champ "); gfx_drawnumber(dbg_sfield, 0);
gfx_drawstr("  = ");
gfx_drawnumber(dbg_sval, 4);

gfx_set(0.42, 0.44, 0.48, 1);
gfx_x = 12; gfx_y = 216;
gfx_drawstr("@gfx tours "); gfx_drawnumber(dbg_gfx, 0);
gfx_drawstr("   voix actives ");
gx_i = 0; gx_k = 0;
loop(NVOICES, voice(gx_i)[V_ACT] ? gx_k += 1; gx_i += 1;);
gfx_drawnumber(gx_k, 0);

// La liste des pads qui portent quelque chose : index, note, images, canaux.
gfx_set(0.55, 0.57, 0.61, 1);
gfx_x = 12; gfx_y = 244; gfx_drawstr("pad   note   images   canaux   Hz");
gx_i = 0; gx_k = 0;
loop(NPADS,
  (pad(gx_i)[P_LOADED] || path_mem(gx_i)[0]) && gx_k < 12 ? (
    gfx_y = 264 + gx_k * 17; gfx_x = 12;
    // UN PAD QUI ATTEND SA MATIERE N'EST PAS UNE ERREUR. Il l'etait a
    // l'ecran : pendant qu'un kit se recharge, toutes ses lignes passaient au
    // rouge le temps d'une frame, ce qui ressemble a une alerte qu'on n'a
    // meme pas le temps de lire. L'ambre dit « en cours », le rouge reste
    // pour ce qui ne se reparera pas tout seul.
    pad(gx_i)[P_LOADED] ? gfx_set(0.78, 0.80, 0.84, 1)
    : (pending_load == gx_i || reload_next >= 0
       || gmem[gm + MB_LSEQ] != gmem[gm + MB_LACK])
        ? gfx_set(0.95, 0.80, 0.40, 1)
        : gfx_set(0.95, 0.45, 0.40, 1);
    gfx_drawnumber(gx_i, 0);
    gfx_x = 60;  gfx_drawnumber(pad(gx_i)[P_NLO], 0);
    gfx_x = 120; gfx_drawnumber(pad(gx_i)[P_FRAMES], 0);
    gfx_x = 210; gfx_drawnumber(pad(gx_i)[P_NCH], 0);
    gfx_x = 280; gfx_drawnumber(pad(gx_i)[P_SRATE], 0);
    gfx_x = 360;
    pad(gx_i)[P_LOADED] ? gfx_drawstr("ok")
    : (pending_load == gx_i || reload_next >= 0
       || gmem[gm + MB_LSEQ] != gmem[gm + MB_LACK])
        ? gfx_drawstr("en attente")
        : gfx_drawstr("chemin sans matiere");
    gx_k += 1;
  );
  gx_i += 1;
);
gx_k == 0 ? (
  gfx_set(0.55, 0.55, 0.58, 1);
  gfx_x = 12; gfx_y = 266;
  gfx_drawstr("aucun pad n'a de chemin — rien n'est arrive de la fenetre");
);
